# Copie este archivo como .env.local y complete los valores de su proyecto Supabase.
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio: SOLO en el servidor (Vercel → Environment Variables). Nunca en el navegador.
# Se usa exclusivamente para enviar invitaciones a las trabajadoras.
SUPABASE_SERVICE_ROLE_KEY=
# URL pública de la aplicación (enlaces de invitación y recuperación de contraseña)
NEXT_PUBLIC_SITE_URL=https://ar-incidencias.example
